{
  "schemaVersion": 1,
  "id": "obsidian",
  "provides": [
    "vulkanmod"
  ],
  "version": "${version}",

  "name": "Obsidian",
  "description": "A faster, smoother fork of VulkanMod with Sodium-style optimizations and a cleaner Video Settings menu.",
  "authors": [
    "ImV"
  ],
  "contact": {
    "homepage": "https://github.com/V1xxcyzz/Obsidian",
    "sources": "https://github.com/V1xxcyzz/Obsidian"
  },

  "icon": "assets/obsidian/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "net.vulkanmod.Initializer"
    ]
  },
  "mixins": [
    "obsidian.mixins.json"
  ],
  "accessWidener": "obsidian.accesswidener",

  "depends": {
    "fabricloader": ">=0.14.14",
    "minecraft": ">=26.2 <26.4"
  },
  "custom": {
    "fabric-renderer-api-v1:contains_renderer": true
  }
}
